  - npcName: NPC #3
    dialogueText: "Jak si\u0119 masz?"
    options:
    - text: "Ca\u0142kiem dobrze"
      nextNodeIndex: 1
      actionType: 0
      itemToGive: {fileID: 0}
    - text: "\u015Arednio, ale ujdzie"
      nextNodeIndex: 2
      actionType: 0
      itemToGive: {fileID: 0}
    - text: "S\u0142abo si\u0119 dzisiaj czuj\u0119, g\u0142owa mnie boli"
      nextNodeIndex: 3
      actionType: 2
      itemToGive: {fileID: 11400000, guid: 0348fb80befff1a448f3fc71af2f8f49, type: 2}
  - npcName: NPC #3
    dialogueText: "Ooo, to super. Mam nadzieje, \u017Ce ca\u0142y tw\xF3j dzie\u0144
      taki b\u0119dzie"
    options:
    - text: "\u017Begnaj"
      nextNodeIndex: -1
      actionType: 0
      itemToGive: {fileID: 0}
  - npcName: NPC #3
    dialogueText: "Hmm, dzie\u0144 si\u0119 jeszcze nie sko\u0144czy\u0142, jeszcze
      mo\u017Ce zmieni si\u0119 na lepsze"
    options:
    - text: Do widzenia
      nextNodeIndex: -1
      actionType: 0
      itemToGive: {fileID: 0}
  - npcName: NPC #3
    dialogueText: "Mam tu co\u015B co ci mo\u017Ce pom\xF3c"
    options:
    - text: "Dzi\u0119ki, do zoboczenia"
      nextNodeIndex: -1
      actionType: 0
      itemToGive: {fileID: 0}
  myShopScript: {fileID: 0}
